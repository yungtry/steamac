@@ -124,4 +124,8 @@ bool FixupWaitStatus(pid_t Pid, int* Status);
 /// Guest path of the binary a traced FEX process exec()ed, if known (for readlink of /proc/<pid>/exe).
 std::optional<std::string> TraceeExePath(pid_t Pid);
 
+/// True if `Pid` is another process that this process traces and that runs under FEX (its state block is reachable),
