   return Creator->second(CTX, AT_FDCWD, pathname, flags, mode);
 }
 
+// /proc/<pid>/maps of a ptrace tracee that is itself a FEX guest process (see PtraceEmu.h). The host file lists the
+// whole host process: the guest's x86-64 mappings, but also FEX's own aarch64 binary, the host libc/ld.so/libstdc++
+// it links against, and its JIT, allocator and lookup-table regions, almost all above the x86-64 user address limit.
+// An x86-64 kernel can never report a mapping there (TASK_SIZE_MAX, arch/x86/include/asm/page_64_types.h).
+//
+// An injector reads its tracee's maps to find a loaded library by name and resolves a function in it through ptrace
+// PEEKs. The Proton Easy Anti-Cheat launcher does this at the tracee's first ld.so syscall, before the guest's libc is
+// mapped: the only "libc.so.6" in the host file is then FEX's aarch64 one, the launcher points the injected call at
+// aarch64 code, the tracee faults outside its return address and the launcher ends with "Unexpected error. (#1)".
+//
+// Serve the host file without the mappings that start at or above that limit; every other line is passed through
+// unchanged, nothing is fabricated. Only another process's maps, and only for a FEX tracee of this process: the
+// guest's own /proc/self/maps and the maps of unrelated processes keep the host view.
+int32_t EmulatedFDManager::ProcTraceeMaps(const char* pathname, int32_t flags) {
+  if (strncmp(pathname, "/proc/", 6) != 0) {
+    return -1;
+  }
+  char* End = nullptr;
+  const long Pid = strtol(pathname + 6, &End, 10);
+  if (End == pathname + 6 || strcmp(End, "/maps") != 0 || !FEX::HLE::PtraceEmu::IsTracedFexProcess(static_cast<pid_t>(Pid))) {
+    return -1;
+  }
+
+  const int HostFD = ::open(pathname, O_RDONLY | O_CLOEXEC);
+  if (HostFD < 0) {
+    return -1;
+  }
+  fextl::string Host;
+  char Buf[16384];
+  ssize_t Len;
+  while ((Len = ::read(HostFD, Buf, sizeof(Buf))) > 0) {
+    Host.append(Buf, Len);
+  }
+  ::close(HostFD);
+
+  constexpr uint64_t X86UserAddressLimit = 0x00007ffffffff000ULL;
+  fextl::string Out;
+  Out.reserve(Host.size());
+  size_t Cursor = 0;
+  while (Cursor < Host.size()) {
+    size_t Eol = Host.find('\n', Cursor);
+    Eol = Eol == fextl::string::npos ? Host.size() : Eol + 1;
+    if (strtoull(Host.c_str() + Cursor, nullptr, 16) < X86UserAddressLimit) {
+      Out.append(Host, Cursor, Eol - Cursor);
+    }
+    Cursor = Eol;
+  }
+
+  const int FD = GenTmpFD(pathname, flags);
+  write(FD, Out.data(), Out.size());
+  lseek(FD, 0, SEEK_SET);
+  SealTmpFD(FD);
+  return FD;
+}
+
 int32_t EmulatedFDManager::ProcStatus(FEXCore::Context::Context* ctx, int32_t fd, const char* pathname, int32_t flags, mode_t mode) {
   char Buf[8192];
   ssize_t Len = 0;
