 /// A control request (PREPARE, START, RELEASE, STOP) is answered, with an error if need be,
-/// within this long. It must stay below the guest driver's virtio_snd.msg_timeout_ms (the
-/// launcher sets 10 s; the kernel default is 1 s).
-const CTL_DEADLINE: Duration = Duration::from_secs(2);
+/// within this long. It is a rescue for a CoreAudio call that does not return, not a latency
+/// target: under load (a starved coreaudiod, memory pressure) a healthy AudioUnit start takes
+/// seconds, and failing it early only makes the guest tear the stream down and retry. It must
+/// stay below the guest driver's virtio_snd.msg_timeout_ms (the launcher sets 10 s; the kernel
+/// default is 1 s).
+const CTL_DEADLINE: Duration = Duration::from_secs(8);
 /// The pump thread has made no progress for this long: queued I/O is failed (see `watchdog_thread`).
+/// A unit request slower than this is logged with where the time went.
+const SLOW_UNIT_JOB: Duration = Duration::from_millis(250);
 const IO_STALL: Duration = Duration::from_secs(3);
 const WATCHDOG_PERIOD: Duration = Duration::from_millis(250);
 /// Non-zero status the converter input proc returns when the ring has no more frames now.
