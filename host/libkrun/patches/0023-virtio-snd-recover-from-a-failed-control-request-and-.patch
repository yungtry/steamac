+                let started = Instant::now();
                 let result = job(&mut slot, &shared, &control);
-                {
-                    let mut hosts = inner.hosts.lock().unwrap();
-                    let host = &mut hosts[id];
-                    host.slot = slot;
-                    host.unit_busy = false;
-                    host.update_latency();
+                let worked = started.elapsed();
+                let mut hosts = inner.hosts.lock().unwrap();
+                let locked = started.elapsed();
+                let host = &mut hosts[id];
+                host.slot = slot;
