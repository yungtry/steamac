+impl CoreAudioBackend {
+    /// A failed control request leaves the guest's queued I/O held by the device, and the guest
+    /// driver refuses its next PREPARE ("invalid I/O queue state") while any is: complete it
+    /// with IO_ERR so the driver can start over.
+    fn recover(&self, stream_id: u32, result: Result<()>) -> Result<()> {
+        if result.is_err() {
+            let failed = self.inner.fail_stream_io(stream_id as usize);
+            if failed > 0 {
+                log::warn!("snd: stream {stream_id}: failed {failed} queued I/O messages after a failed control request");
+            }
         }
-        st.state.set_parameters().map_err(|err| {
-            log::error!("snd: stream {stream_id} set_parameters: {err}");
-            Error::Stream(err)
-        })?;
-        st.params.features = request.features;
-        st.params.buffer_bytes = request.buffer_bytes;
-        st.params.period_bytes = request.period_bytes;
-        st.params.channels = request.channels;
-        st.params.format = request.format;
-        st.params.rate = request.rate;
-        Ok(())
+        result
     }
 
-    fn prepare(&self, stream_id: u32) -> Result<()> {
+    fn do_prepare(&self, stream_id: u32) -> Result<()> {
         self.transition(stream_id, "prepare", PCMState::Prepare, PCMState::prepare)?;
         let (fmt, buffer) = {
             let params = &self.inner.streams.read().unwrap()[stream_id as usize].params;
@@ -3066,7 +3069,7 @@ impl AudioBackend for CoreAudioBackend {
         Ok(())
     }
 
-    fn release(&self, stream_id: u32) -> Result<()> {
+    fn do_release(&self, stream_id: u32) -> Result<()> {
         self.transition(stream_id, "release", PCMState::Release, PCMState::release)?;
         let id = stream_id as usize;
         // Playback: note what to drain, but never hold `hosts` across the wait (the pump thread
@@ -3100,7 +3103,7 @@ impl AudioBackend for CoreAudioBackend {
         Ok(())
     }
 
-    fn start(&self, stream_id: u32) -> Result<()> {
+    fn do_start(&self, stream_id: u32) -> Result<()> {
         self.transition(stream_id, "start", PCMState::Start, PCMState::start)?;
         let id = stream_id as usize;
         let fmt = {
@@ -3162,6 +3165,54 @@ impl AudioBackend for CoreAudioBackend {
