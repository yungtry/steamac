+}
+
+impl AudioBackend for CoreAudioBackend {
+    fn write(&self, _stream_id: u32) -> Result<()> {
+        self.inner.wake.signal();
+        Ok(())
+    }
+
+    fn read(&self, _stream_id: u32) -> Result<()> {
+        self.inner.wake.signal();
+        Ok(())
+    }
+
+    fn set_parameters(&self, stream_id: u32, request: VirtioSndPcmSetParams) -> Result<()> {
+        let mut streams = self.inner.streams.write().unwrap();
+        let st = streams
+            .get_mut(stream_id as usize)
+            .ok_or(Error::StreamWithIdNotFound(stream_id))?;
+        if !st.supports_format(request.format)
+            || !st.supports_rate(request.rate)
+            || !(st.channels_min..=st.channels_max).contains(&request.channels)
+        {
+            return Err(Error::UnexpectedAudioBackendConfiguration);
+        }
+        st.state.set_parameters().map_err(|err| {
+            log::error!("snd: stream {stream_id} set_parameters: {err}");
+            Error::Stream(err)
+        })?;
+        st.params.features = request.features;
+        st.params.buffer_bytes = request.buffer_bytes;
+        st.params.period_bytes = request.period_bytes;
+        st.params.channels = request.channels;
+        st.params.format = request.format;
+        st.params.rate = request.rate;
+        Ok(())
+    }
+
+    fn prepare(&self, stream_id: u32) -> Result<()> {
+        self.recover(stream_id, self.do_prepare(stream_id))
+    }
+
+    fn release(&self, stream_id: u32) -> Result<()> {
+        self.recover(stream_id, self.do_release(stream_id))
+    }
+
+    fn start(&self, stream_id: u32) -> Result<()> {
+        self.recover(stream_id, self.do_start(stream_id))
+    }
 
     fn stop(&self, stream_id: u32) -> Result<()> {
         self.transition(stream_id, "stop", PCMState::Stop, PCMState::stop)?;
@@ -3299,6 +3350,74 @@ mod tests {
         }
     }
 
+    /// Manual timing of the real CoreAudio calls a PREPARE/START/STOP/RELEASE cycle makes.
+    #[test]
+    #[ignore = "uses the real default output device"]
+    fn real_device_cycle_timing() {
+        let ms = |t: Instant| t.elapsed().as_secs_f64() * 1000.0;
+        let control = Arc::new(SndControl::default());
+        let t = Instant::now();
+        let _ = control.playback_maps();
+        eprintln!("playback_maps (first): {:.1} ms", ms(t));
+        for _ in 0..3 {
+            let t = Instant::now();
+            let route = output_route(&control);
+            eprintln!("output_route: {:.1} ms {:?}", ms(t), route.is_some());
+        }
+        let wake = Arc::new(Semaphore::new().unwrap());
+        let shared = Shared::new(Direction::Output, false, wake);
+        let fmt = Format {
+            format: VIRTIO_SND_PCM_FMT_S16,
+            rate: 48000,
+            channels: 2,
+        };
+        for round in 0..5 {
+            let mut slot = UnitSlot::default();
+            let t = Instant::now();
+            slot.configure(fmt, &shared, &control).unwrap();
+            let configure = ms(t);
+            let t = Instant::now();
+            slot.start(false).unwrap();
+            let start = ms(t);
+            std::thread::sleep(Duration::from_millis(300));
+            let t = Instant::now();
+            slot.stop();
+            let stop = ms(t);
+            let t = Instant::now();
+            drop(slot);
+            eprintln!(
+                "round {round}: configure {configure:.1} ms, start {start:.1} ms, stop {stop:.1} ms, drop {:.1} ms",
+                ms(t)
+            );
+        }
+        let backend = backend(Duration::from_secs(10), Duration::from_secs(60));
+        backend.inner.streams.write().unwrap()[0].state = PCMState::SetParameters;
+        for round in 0..5 {
+            let mut worst = (0.0f64, "");
+            for (what, op) in [
+                (
+                    "prepare",
+                    &(|| backend.prepare(0)) as &dyn Fn() -> Result<()>,
+                ),
+                ("start", &|| backend.start(0)),
+                ("stop", &|| backend.stop(0)),
+                ("release", &|| backend.release(0)),
+            ] {
+                let t = Instant::now();
+                op().unwrap();
+                let d = ms(t);
+                eprintln!("cycle {round} {what}: {d:.1} ms");
+                if d > worst.0 {
+                    worst = (d, what);
+                }
+                if what == "start" {
+                    std::thread::sleep(Duration::from_millis(300));
+                }
+            }
+            eprintln!("cycle {round} worst: {:.1} ms ({})", worst.0, worst.1);
+        }
+    }
+
     /// The AudioUnit work of a control request runs without `hosts`: the pump keeps completing
     /// the guest's I/O while a unit call is in flight. (Before: PREPARE/START ran
     /// stop/configure/start under `hosts`, the pump waited, and the guest's messages stayed
@@ -3385,6 +3504,29 @@ mod tests {
         }
     }
 
+    /// A control request that fails (here: the pump holds `hosts` past the deadline) completes
+    /// the stream's queued I/O with IO_ERR. Held, it would keep the guest's I/O queue busy and the
+    /// driver would refuse every further PREPARE with "invalid I/O queue state" while the device
+    /// waits for that PREPARE to flush it.
+    #[test]
+    fn failed_control_request_releases_the_guests_queued_io() {
+        let backend = Arc::new(backend(CTL, Duration::from_secs(60)));
+        let _stuck = StuckPump::new(&backend);
+        let message = queue_message(&backend);
+        assert!(backend.prepare(0).is_err());
+        assert!(completed(&message), "the failed PREPARE left I/O queued");
+        assert_eq!(message.status.load(Ordering::SeqCst), VIRTIO_SND_S_IO_ERR);
+    }
+
+    /// The deadline rescues a call that never returns; it must not fire on the seconds an
+    /// AudioUnit start takes under load (lean run A_N19: "prepare took more than 2s", then the
+    /// guest's queue-state storm), and it must stay below the launcher's 10 s guest timeout.
+    #[test]
+    fn control_deadline_leaves_room_for_a_loaded_hal() {
+        assert!(CTL_DEADLINE >= Duration::from_secs(5));
+        assert!(CTL_DEADLINE < Duration::from_secs(10));
+    }
+
     /// Queued I/O is failed with IO_ERR when the pump stops making progress, so the guest's
     /// queues drain. (Before: nothing completed it; the guest kept "invalid I/O queue state"
     /// for ever.)
