+
+    const CTL: Duration = Duration::from_millis(300);
+    const STALL: Duration = Duration::from_millis(400);
+
+    /// A backend with a playback stream 0 (state Release, i.e. not prepared yet), without
+    /// touching CoreAudio.
+    fn backend(ctl: Duration, stall: Duration) -> CoreAudioBackend {
+        let mut stream = Stream::default();
+        stream.params.rate = VIRTIO_SND_PCM_RATE_48000;
+        stream.params.channels = 2;
+        stream.state = PCMState::Release;
+        let streams = Arc::new(RwLock::new(vec![stream]));
+        CoreAudioBackend::with_deadlines(streams, Arc::new(SndControl::default()), ctl, stall)
+            .unwrap()
+    }
+
+    /// A queued playback message; `Arc::strong_count(&msg) == 1` once the device has dropped
+    /// (completed) every buffer of it.
+    fn queue_message(backend: &CoreAudioBackend) -> Arc<IOMessage> {
+        let mem = GuestMemoryMmap::<()>::from_ranges(&[(GuestAddress(0), 0x1000)]).unwrap();
+        let interrupt =
+            InterruptTransport::new(DummyIrqChip::new().into(), "snd-test".into()).unwrap();
+        let message = Arc::new(IOMessage {
+            status: AtomicU32::new(VIRTIO_SND_S_OK),
+            used_len: 0.into(),
+            latency_bytes: 0.into(),
+            head_index: 0,
+            response_descriptor: Descriptor {
+                addr: 0x100,
+                len: 8,
+                flags: 0,
+                next: 0,
+            },
+            vring: Arc::new(Mutex::new(Vring {
+                mem,
+                queue: Queue::new(16),
+                interrupt,
+            })),
+        });
+        backend.inner.streams.write().unwrap()[0]
+            .buffers
+            .push_back(Buffer::new(
+                Descriptor {
+                    addr: 0,
+                    len: 0,
+                    flags: 0,
+                    next: 0,
+                },
+                message.clone(),
+                Direction::Output,
+            ));
+        backend.write(0).unwrap();
+        message
+    }
+
+    /// Holds `hosts` like a pump stuck in an AudioUnit call, until dropped.
+    struct StuckPump {
+        release: Option<mpsc::Sender<()>>,
+        thread: Option<std::thread::JoinHandle<()>>,
+    }
+
+    impl StuckPump {
+        fn new(backend: &Arc<CoreAudioBackend>) -> Self {
+            let backend = backend.clone();
+            let (locked, locked_rx) = mpsc::channel::<()>();
+            let (release, gate) = mpsc::channel::<()>();
+            let thread = std::thread::spawn(move || {
+                let _hosts = backend.inner.hosts.lock().unwrap();
+                locked.send(()).unwrap();
+                gate.recv().ok();
+            });
+            locked_rx.recv().unwrap();
+            Self {
+                release: Some(release),
+                thread: Some(thread),
+            }
+        }
+    }
+
+    impl Drop for StuckPump {
+        fn drop(&mut self) {
+            drop(self.release.take());
+            self.thread.take().unwrap().join().unwrap();
+        }
+    }
+
+    fn completed(message: &Arc<IOMessage>) -> bool {
+        Arc::strong_count(message) == 1
+    }
+
+    fn wait_for(what: &str, limit: Duration, mut done: impl FnMut() -> bool) {
+        let start = Instant::now();
+        while !done() {
+            assert!(start.elapsed() < limit, "timed out waiting for {what}");
+            std::thread::sleep(Duration::from_millis(5));
+        }
+    }
