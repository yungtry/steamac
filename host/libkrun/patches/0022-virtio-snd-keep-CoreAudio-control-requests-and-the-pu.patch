+/// One capture start worker per stream. A START records its format here and spawns a worker
+/// only when none runs; the running worker serves the newest recorded request when it is done
+/// with the current one, and a STOP drops a request it has not served yet. Without this, every
+/// START (and every input-device check while a start was still opening the microphone) spawned
+/// another worker; they queued up behind CoreAudio's HAL lock by the hundreds.
+/// `busy` mirrors "a worker runs or will run" for lock-free readers (`Shared::starting`); it
+/// only changes under the gate's lock, so it cannot be cleared behind a new request.
+struct StartGate<T> {
+    inner: Mutex<(bool, Option<T>)>,
+}
+
+impl<T> Default for StartGate<T> {
+    fn default() -> Self {
+        Self {
+            inner: Mutex::new((false, None)),
+        }
+    }
+}
+
+impl<T> StartGate<T> {
+    /// Record a request. Returns true when the caller must spawn the worker.
+    fn request(&self, req: T, busy: &AtomicBool) -> bool {
+        let mut g = self.inner.lock().unwrap();
+        g.1 = Some(req);
+        busy.store(true, Ordering::Release);
+        !std::mem::replace(&mut g.0, true)
+    }
+
+    /// Worker: the next request to serve, or `None` when there is none (the worker then exits;
+    /// `busy` is cleared).
+    fn next(&self, busy: &AtomicBool) -> Option<T> {
+        let mut g = self.inner.lock().unwrap();
+        let req = g.1.take();
+        if req.is_none() {
+            g.0 = false;
+            busy.store(false, Ordering::Release);
+        }
+        req
+    }
+
+    /// A STOP: drop a request the worker has not taken yet.
+    fn cancel(&self) {
+        self.inner.lock().unwrap().1 = None;
+    }
+
+    /// The worker could not be spawned: nothing runs.
+    fn abandon(&self, busy: &AtomicBool) {
+        let mut g = self.inner.lock().unwrap();
+        *g = (false, None);
+        busy.store(false, Ordering::Release);
+    }
+}
+
+/// Capture start worker thread: serves start requests until none is left.
+fn capture_start_thread(shared: Arc<Shared>, id: usize) {
+    while let Some(fmt) = shared.start_gate.next(&shared.starting) {
+        capture_start_worker(&shared, fmt, id);
+    }
+}
