+/// The playback AudioUnit and what it is configured for. A control operation takes the slot out
+/// of its `HostStream` (`CoreAudioBackend::unit_job`) and runs its AudioUnit calls on it without
+/// holding `hosts`; meanwhile the pump sees a stream that is not configured yet and carries on.
+/// For capture only `format` is used (the guest format of the last PREPARE); the unit lives in
+/// `Shared::capture`.
+#[derive(Default)]
+struct UnitSlot {
+    unit: Option<Unit>,
+    /// Guest format the unit is configured for.
+    format: Option<Format>,
+    /// Route the unit was created for (device, physical speakers).
+    output_route: Option<OutputRoute>,
+}
+
+impl UnitSlot {
+    fn create_unit(&mut self, shared: &Shared, control: &SndControl) -> Result<()> {
+        if self.unit.is_some() {
+            return Ok(());
+        }
+        let route = output_route(control).ok_or_else(|| {
+            Error::UnexpectedAudioBackendError("no usable output device".into())
+        })?;
+        let unit = Unit::new(kAudioUnitSubType_HALOutput)?;
+        unit.set(
+            kAudioOutputUnitProperty_CurrentDevice,
+            kAudioUnitScope_Global,
+            0,
+            &route.device,
+            "CurrentDevice(output)",
+        )?;
+        self.output_route = Some(route);
+        let cb = AURenderCallbackStruct {
+            inputProc: render_output,
+            inputProcRefCon: shared as *const Shared as *mut c_void,
+        };
+        unit.set(
+            kAudioUnitProperty_SetRenderCallback,
+            kAudioUnitScope_Input,
+            0,
+            &cb,
+            "SetRenderCallback",
+        )?;
+        self.unit = Some(unit);
+        Ok(())
+    }
+
+    /// (Re)configure the unit for `fmt`. The unit is left initialized and stopped; the caller
+    /// refreshes the stream's latency afterwards (`HostStream::update_latency`).
+    fn configure(&mut self, fmt: Format, shared: &Shared, control: &SndControl) -> Result<()> {
+        self.create_unit(shared, control)?;
+        let unit = self.unit.as_mut().unwrap();
+        unit.uninitialize();
+        let route = self.output_route.as_ref().unwrap();
+        let source = control
+            .playback_maps()
+            .get(fmt.channels as usize - 1)
+            .ok_or(Error::UnexpectedAudioBackendConfiguration)?;
+        let mixer = Mixer::new(fmt.format, source, &route.positions);
+        unit.set(
+            kAudioUnitProperty_StreamFormat,
+            kAudioUnitScope_Input,
+            0,
+            &float_asbd(fmt.rate as f64, mixer.output_channels as u32),
+            "StreamFormat(output)",
+        )?;
+        // Identity map over every physical channel. A device wider than the mixer
+        // (stereo route) keeps the HAL's default mapping instead.
+        if route.device_channels == mixer.output_channels {
+            let map: Vec<i32> = (0..mixer.output_channels as i32).collect();
+            // SAFETY: map is a live array of physical output-channel indices.
+            check(
+                unsafe {
+                    AudioUnitSetProperty(
+                        unit.au,
+                        kAudioOutputUnitProperty_ChannelMap,
+                        kAudioUnitScope_Input,
+                        0,
+                        map.as_ptr().cast(),
+                        (map.len() * 4) as u32,
+                    )
+                },
+                "ChannelMap(output)",
+            )?;
+        }
+        // SAFETY: the unit was uninitialized above, so no render callback can read the mixer.
+        unsafe {
+            *shared.mixer.get() = mixer;
+        }
+        log::info!(
+            "snd: routes guest {:?} to '{}' speakers {:?}",
+            source,
+            device_name(route.device),
+            route.positions
+        );
+        shared
+            .frame_bytes
+            .store(fmt.frame_bytes(), Ordering::Relaxed);
+        // fifo_bytes: update_latency(), once the unit knows its device.
+        shared.channels.store(fmt.channels, Ordering::Relaxed);
+        shared.silence.store(fmt.silence(), Ordering::Relaxed);
+        unit.initialize()?;
+        unit.set_volume(control.volume());
+        self.format = Some(fmt);
+        Ok(())
+    }
+
+    /// Start the configured unit. `Ok(false)`: the VM is paused, the unit starts again on
+    /// resume (`HostStream::follow_pause`).
+    fn start(&mut self, paused: bool) -> Result<bool> {
+        match self.unit.as_mut() {
+            Some(unit) if unit.initialized && paused => Ok(false),
+            Some(unit) if unit.initialized => unit.start().map(|()| true),
+            _ => Err(Error::UnexpectedAudioBackendError(
+                "stream not prepared".into(),
+            )),
+        }
+    }
+
+    fn stop(&mut self) {
+        if let Some(unit) = self.unit.as_mut() {
+            unit.stop();
+        }
+    }
+}
