+#[cfg(test)]
+mod start_gate_tests {
+    use super::StartGate;
+    use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+    use std::sync::Arc;
+    use std::time::Duration;
+
+    #[test]
+    fn one_worker_serves_the_newest_request() {
+        let gate = StartGate::default();
+        let busy = AtomicBool::new(false);
+        assert!(gate.request(1, &busy), "first START spawns the worker");
+        assert!(busy.load(Ordering::Acquire));
+        assert!(
+            !gate.request(2, &busy),
+            "a START while the worker runs spawns nothing"
+        );
+        assert!(!gate.request(3, &busy));
+        assert_eq!(
+            gate.next(&busy),
+            Some(3),
+            "the worker serves only the newest request"
+        );
+        assert!(
+            busy.load(Ordering::Acquire),
+            "busy until the worker has nothing left"
+        );
+        assert_eq!(gate.next(&busy), None);
+        assert!(!busy.load(Ordering::Acquire));
+        assert!(
+            gate.request(4, &busy),
+            "after the worker exited, a START spawns again"
+        );
+    }
+
+    #[test]
+    fn stop_drops_an_unserved_request() {
+        let gate = StartGate::default();
+        let busy = AtomicBool::new(false);
+        assert!(gate.request(1, &busy));
+        gate.cancel();
+        assert_eq!(gate.next(&busy), None);
+        assert!(!busy.load(Ordering::Acquire));
+        assert!(gate.request(2, &busy));
+        gate.abandon(&busy);
+        assert!(!busy.load(Ordering::Acquire));
+        assert!(gate.request(3, &busy), "abandon leaves the gate usable");
+    }
