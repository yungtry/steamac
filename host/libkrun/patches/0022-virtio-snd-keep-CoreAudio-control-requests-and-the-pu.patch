+        }
+        assert_eq!(
+            peak.load(Ordering::SeqCst),
+            1,
+            "more than one start in progress at a time"
+        );
+        assert!(
+            served.load(Ordering::SeqCst) < 500,
+            "superseded requests were not coalesced"
+        );
+        assert!(!busy.load(Ordering::SeqCst));
+        assert_eq!(gate.next(&busy), None, "a request was left unserved");
+    }
+}
