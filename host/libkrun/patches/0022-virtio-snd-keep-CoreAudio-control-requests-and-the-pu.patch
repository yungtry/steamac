+    /// the guest's I/O while a unit call is in flight. (Before: PREPARE/START ran
+    /// stop/configure/start under `hosts`, the pump waited, and the guest's messages stayed
+    /// queued for as long as the AudioUnit call took.)
+    #[test]
+    fn pump_runs_while_a_unit_job_is_in_flight() {
+        let backend = Arc::new(backend(Duration::from_secs(5), Duration::from_secs(60)));
+        let (release, gate) = mpsc::channel::<()>();
+        let b = backend.clone();
+        let job = std::thread::spawn(move || {
+            b.unit_job(0, "test", move |_, _, _| {
+                gate.recv().ok(); // an AudioUnit call that does not return
+                Ok(())
+            })
+        });
+        wait_for("the job to take the unit", Duration::from_secs(2), || {
+            backend.inner.hosts.lock().unwrap()[0].unit_busy
+        });
+        // Not prepared: the pump completes I/O queued outside PREPARE..RELEASE at once.
+        let message = queue_message(&backend);
+        wait_for(
+            "the pump to complete the message",
+            Duration::from_secs(2),
+            || completed(&message),
+        );
+        assert_eq!(message.status.load(Ordering::SeqCst), VIRTIO_SND_S_BAD_MSG);
+        release.send(()).unwrap();
+        job.join().unwrap().unwrap();
+        assert!(!backend.inner.hosts.lock().unwrap()[0].unit_busy);
+    }
+
+    /// A unit request that does not finish is failed after the deadline instead of blocking the
+    /// device's worker thread; the next one fails at once as busy, and the stream is usable
+    /// again once the stuck one returns.
